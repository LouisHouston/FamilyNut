{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Django Server",
      "type": "shell",
      "command": "python manage.py runserver 0.0.0.0:8000",
      "options": {
        "cwd": "${workspaceFolder}/FNBackend"
      },
      "presentation": {
        "panel": "dedicated"
      }
    },
    {
      "label": "Expo Server",
      "type": "shell",
      "command": "npx expo start",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "presentation": {
        "panel": "dedicated"
      }
    },
    {
      "label": "Start FamilyNut",
      "dependsOn": [
        "Django Server",
        "Expo Server"
      ],
      "dependsOrder": "parallel"
    }
  ]
}